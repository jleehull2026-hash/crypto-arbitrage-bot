import ccxt

from arbitrage_bot.exchanges.base import BaseExchange


class GateExchange(BaseExchange):
    name = "gate"

    @classmethod
    def build(cls, api_key: str = "", api_secret: str = ""):
        exchange = ccxt.gateio({"apiKey": api_key, "secret": api_secret, "enableRateLimit": True})
        return cls(exchange)
